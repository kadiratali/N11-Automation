        <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor">
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <boolProp name="resetInterpreter">false</boolProp>
          <stringProp name="script">import java.io.File;
import java.io.BufferedReader;
import java.io.FileReader;

// Dosya yolunu tanımla
String filePath = System.getProperty(&quot;user.home&quot;) + File.separator + &quot;Desktop&quot; + File.separator + &quot;n11_cookies.txt&quot;;

File cookiesFile = new File(filePath);

// Dosyanın varlığını kontrol et
if (cookiesFile.exists()) {
    log.info(&quot;Dosya başarıyla bulundu: &quot; + filePath);
    try {
        BufferedReader reader = new BufferedReader(new FileReader(cookiesFile));
        String cookiesString = reader.readLine();
        reader.close();

        if (cookiesString != null &amp;&amp; !cookiesString.isEmpty()) {
            log.info(&quot;Dosya içeriği okundu: &quot; + cookiesString);
            // Kalan kodunuzu buraya ekleyebilirsiniz
        } else {
            log.info(&quot;Dosya boş.&quot;);
        }
    } catch (Exception e) {
        log.error(&quot;Dosya okunurken bir hata oluştu: &quot; + e.getMessage());
    }
} else {
    log.error(&quot;Hata: Dosya bulunamadı: &quot; + filePath);
}</stringProp>
        </BeanShellPreProcessor>
